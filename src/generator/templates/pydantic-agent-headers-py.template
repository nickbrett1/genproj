"""Forward LiteLLM context headers from the A2A request to the model calls.

When LiteLLM invokes this agent it sends:

    X-LiteLLM-Trace-Id   groups all LLM calls from one agent execution
    X-LiteLLM-Agent-Id   attributes spend to this agent

Forwarding those headers on the agent's own LLM calls back to LiteLLM is what
makes trace grouping and cost attribution work. Without it both features
silently do nothing - the calls look wired up and produce ungrouped,
unattributed traces.

The A2A SDK puts the incoming HTTP request's headers on the call context
(`context.call_context.state["headers"]`), but the model is called from inside
the executor, which does not otherwise see them. So:

  1. the executor calls `bind_litellm_headers(context.call_context.state["headers"])`
     to put the request's `X-LiteLLM-*` headers in a context variable for the
     turn;
  2. `HeaderForwardingClient` injects them on every outbound model request.

This is request/turn-scoped: the executor binds the headers before it runs the
agent, so concurrent turns on different tasks do not see each other's headers.
"""

from __future__ import annotations

import contextvars

import httpx

_headers: contextvars.ContextVar[dict[str, str]] = contextvars.ContextVar(
    "litellm_headers", default={}
)


def current_litellm_headers() -> dict[str, str]:
    """The LiteLLM context headers for the turn being run, if any."""
    return _headers.get()


def bind_litellm_headers(headers: dict[str, str]) -> None:
    """Put this turn's `X-LiteLLM-*` headers in scope for the model calls it makes.

    Header names are matched case-insensitively, since HTTP header casing is not
    significant.
    """
    forwarded = {
        key.lower(): value
        for key, value in headers.items()
        if key.lower().startswith("x-litellm-")
    }
    _headers.set(forwarded)


class HeaderForwardingClient(httpx.AsyncClient):
    """An HTTP client that adds the current turn's LiteLLM headers."""

    async def send(self, request, **kwargs):
        for key, value in current_litellm_headers().items():
            request.headers.setdefault(key, value)
        return await super().send(request, **kwargs)
