PACKAGE_ROOT = Path(__file__).resolve().parent
INSTRUCTIONS_PATH = PACKAGE_ROOT.parent / "prompts" / "instructions.md"

AGENT_NAME = "{{agentName}}"
AGENT_DESCRIPTION = {{agentDescriptionLiteral}}
AGENT_VERSION = "0.1.0"

# The A2A dialect this server speaks. The served card advertises exactly this,
# and nothing else, so the card is a statement about the wire - not a wish.
PROTOCOL_VERSION = "{{protocolVersion}}"

# The JSON-RPC method each dialect uses to send a message. A version is only
# advertised on the card if it appears here; a version in here is one the
# endpoint really accepts (verified by tests/test_a2a_wire.py).
SEND_METHOD_BY_DIALECT: dict[str, str] = {
    "1.0": "SendMessage",
    "0.3": "message/send",
}
# The dialects this endpoint is configured to accept. `a2a-sdk`'s v1.0 handler is
# always on; the legacy 0.3 dialect rides on its backward-compat adapter, which
# is enabled below only when "0.3" is in this set. Advertising a version whose
# adapter is off is exactly the lie this scaffold exists to prevent.
SUPPORTED_DIALECTS: frozenset[str] = frozenset({PROTOCOL_VERSION})

# The URL the card advertises - the address the LiteLLM proxy dials. It must be
# reachable from the proxy's host, so it is an address, not a loopback name.
CARD_URL = os.environ.get("A2A_CARD_URL", "http://0.0.0.0:{{listenPort}}")


def _load_instructions() -> str:
    """The agent's instructions, read fresh from prompts/instructions.md.

    That file is human-owned: genproj seeds it once and regeneration never
    overwrites it, so instruction changes do not require regeneration.
    """
    if INSTRUCTIONS_PATH.exists():
        return INSTRUCTIONS_PATH.read_text(encoding="utf-8")
    return {{agentInstructionsLiteral}}


def build_agent_card() -> AgentCard:
    """The card this server publishes, built from the one protocol version.

    `supported_interfaces` is the field the LiteLLM gateway reads to choose a
    transport, so its `protocol_version` must equal `PROTOCOL_VERSION` - a value
    this same module is configured to serve.
    """
    return AgentCard(
        name=AGENT_NAME,
        description=AGENT_DESCRIPTION,
        version=AGENT_VERSION,
        supported_interfaces=[
            AgentInterface(
                url=CARD_URL,
                protocol_binding=TransportProtocol.JSONRPC.value,
                protocol_version=PROTOCOL_VERSION,
            )
        ],
        capabilities=AgentCapabilities(streaming=True),
        default_input_modes=["application/json"],
        default_output_modes=["application/json"],
        skills=[AgentSkill(**skill) for skill in AGENT_SKILLS],
    )


{{agentToolsetsSetup}}agent = Agent(
    build_model(),
    instructions=_load_instructions(),
    # PromptedOutput, not the default ToolOutput and not NativeOutput: on a
    # thinking model (e.g. deepseek-v4-flash) forced tool_choice is rejected
    # ("Thinking mode does not support this tool_choice") and json_schema
    # response_format is unavailable ("This response_format type is unavailable
    # now"). PromptedOutput asks for the schema in the prompt and works there.
    output_type=PromptedOutput(AgentResult),
    # Reasoning tokens bill against max_tokens, so a small cap truncates the
    # answer before it is emitted. 4096 leaves room for the reasoning.
    model_settings=ModelSettings(max_tokens=4096),
    retries={"output": {{maxOutputRetries}}},
    {{agentToolsetsArg}}
)
# The Validator layer. It runs on every model output; on failure it raises
# ModelRetry with real error text, up to `retries["output"]` times.
agent.output_validator(validate_agent_result)


class PydanticAIAgentExecutor(AgentExecutor):
    """Runs the Pydantic AI agent and reports the result as an A2A task.

    One request is one turn. The turn's output is attached as an artifact (and
    echoed on the completion status message), so a caller gets the structured
    answer whichever envelope it reads.
    """

    def __init__(self, agent: Agent, roost_bridge: RoostBridge | None = None) -> None:
        self._agent = agent
        # The fleet hub. A no-op bridge when roost is unconfigured, so this class
        # never has to branch on whether roost is on (fail-open).
        self._roost = roost_bridge or RoostBridge()

    async def execute(
        self, context: RequestContext, event_queue: EventQueue
    ) -> None:
        assert context.task_id is not None
        assert context.context_id is not None
        task_id = context.task_id
        context_id = context.context_id
        # The a2a-sdk event pipeline requires the Task to be enqueued before any
        # status/artifact update (otherwise the consumer raises
        # InvalidAgentResponseError). On a fresh request we mint it from the user
        # message; on a follow-up the framework hands us the stored task - and
        # that stored task is exactly what makes the turn readable as history.
        initial_task = context.current_task
        if initial_task is None and context.message is not None:
            initial_task = new_task_from_user_message(context.message)
        if initial_task is not None:
            await event_queue.enqueue_event(initial_task)
        updater = TaskUpdater(event_queue, task_id, context_id)
        # The A2A SDK carries the request's HTTP headers into the call context;
        # agent/headers.py forwards the X-LiteLLM-* ones onto this turn's model
        # calls so traces group and spend is attributed.
        bind_litellm_headers(context.call_context.state.get("headers", {}))
        # Reflect the turn in the roost fleet. The counter and the emits are
        # best-effort and never await the model, so a long turn cannot make the
        # hub's `status.get` poll time out (which is what would drop the tunnel).
        self._roost.turn_started()
        await self._roost.emit("turn_started", taskId=task_id)
        await updater.submit()
        try:
            result = await self._agent.run(context.get_user_input())
        except Exception as exc:
            # Report the failure as the task's terminal state instead of
            # letting the framework turn it into an opaque 500.
            await updater.failed(
                new_text_message(
                    f"The agent failed: {exc}",
                    task_id=task_id,
                    context_id=context_id,
                )
            )
            return
        finally:
            self._roost.turn_finished()
            await self._roost.emit("finished", taskId=task_id)
        text = result.output.model_dump_json(indent=2)
        await updater.add_artifact([new_text_part(text)], name="result")
        await updater.complete(
            new_text_message(text, task_id=task_id, context_id=context_id)
        )

    async def cancel(
        self, context: RequestContext, event_queue: EventQueue
    ) -> None:
        assert context.task_id is not None
        assert context.context_id is not None
        updater = TaskUpdater(event_queue, context.task_id, context.context_id)
        await updater.cancel()


def _build_request_handler(
    executor: AgentExecutor, task_store: TaskStore
) -> DefaultRequestHandler:
    """The SDK request handler, wired to this executor, card and task store.

    `enable_v0_3_compat` is derived from `SUPPORTED_DIALECTS` rather than
    hard-coded, so enabling the legacy dialect is a one-line change that keeps
    the card and the endpoint in step.
    """
    return DefaultRequestHandler(
        agent_executor=executor,
        task_store=task_store,
        agent_card=build_agent_card(),
    )


