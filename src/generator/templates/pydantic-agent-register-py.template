"""Register this agent with the LiteLLM gateway (generated by genproj).

The container is the source of truth for its own card: registration runs at
startup, is idempotent by name, and FAILS OPEN. A gateway outage must not stop
the agent from serving - the failure is logged and the server keeps running; the
next restart (or a periodic retry) re-registers.

The credential is a key bound to a `proxy_admin` USER, read from the environment
variable named by `registrationKeyEnv` ({{registrationKeyEnv}}). It is NOT the
master key, and it is NOT a key minted with `user_role` on `/key/generate` -
that field is silently ignored and yields a non-admin key that gets HTTP 403
from POST /v1/agents. See agent/README.md for how to mint the user and key.
"""

from __future__ import annotations

import os

import httpx

LITELLM_BASE_URL = os.environ.get("LITELLM_BASE_URL", "{{litellmBaseUrl}}")
REGISTRATION_KEY_ENV = "{{registrationKeyEnv}}"
TIMEOUT = float(os.environ.get("LITELLM_REGISTRATION_TIMEOUT", "10"))


async def register_with_litellm(
    *,
    agent_name: str,
    card_url: str,
    protocol_version: str,
    description: str,
    skills: list,
) -> None:
    """Create or update this agent's record in the gateway. Fail open."""
    key = os.environ.get(REGISTRATION_KEY_ENV, "")
    if not key:
        print(
            f"[register] {REGISTRATION_KEY_ENV} is not set - skipping LiteLLM "
            "registration (fail open). See agent/README.md.",
            flush=True,
        )
        return

    card = {
        "name": agent_name,
        "description": description,
        "url": card_url,
        # Pin the wire format LiteLLM serves for this agent. Unpinned, the
        # served version is inferred per client request while the proxied card
        # defaults to 1.0, so card and responses can disagree.
        "protocolVersion": protocol_version,
        "version": "0.1.0",
        "defaultInputModes": ["application/json"],
        "defaultOutputModes": ["application/json"],
        "capabilities": {"streaming": True},
        "skills": skills,
    }
    payload = {"agent_name": agent_name, "agent_card_params": card}
    headers = {
        "Authorization": f"Bearer {key}",
        "Content-Type": "application/json",
    }

    try:
        async with httpx.AsyncClient(timeout=TIMEOUT) as client:
            agent_id = await _find_agent_id(client, headers, agent_name)
            if agent_id:
                url = f"{LITELLM_BASE_URL}/v1/agents/{agent_id}"
                response = await client.put(url, json=payload, headers=headers)
            else:
                url = f"{LITELLM_BASE_URL}/v1/agents"
                response = await client.post(url, json=payload, headers=headers)
            response.raise_for_status()
            verb = "updated" if agent_id else "registered"
            print(f"[register] {verb} '{agent_name}' with {LITELLM_BASE_URL}", flush=True)
    except Exception as exc:  # fail open: a gateway outage must not stop serving
        print(
            f"[register] could not register '{agent_name}' with "
            f"{LITELLM_BASE_URL}: {exc!r} (fail open; will retry on restart)",
            flush=True,
        )


async def _find_agent_id(
    client: httpx.AsyncClient, headers: dict, agent_name: str
) -> str | None:
    """This agent's gateway id, by name, or None when it is not registered yet."""
    response = await client.get(f"{LITELLM_BASE_URL}/v1/agents", headers=headers)
    response.raise_for_status()
    for agent in response.json():
        if not isinstance(agent, dict):
            continue
        card = agent.get("agent_card_params") or {}
        if agent.get("agent_name") == agent_name or card.get("name") == agent_name:
            return agent.get("agent_id")
    return None
