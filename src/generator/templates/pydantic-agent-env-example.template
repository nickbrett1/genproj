# Environment for the {{agentName}} A2A agent.
# Generated by genproj. Do NOT commit real values; inject them from Doppler.
#
# The agent container reads these from its environment at startup.

# The LiteLLM gateway. Used for BOTH outbound model calls and startup
# self-registration.
LITELLM_BASE_URL={{litellmBaseUrl}}

# A virtual key scoped to invoking this agent and calling the models it uses.
LITELLM_API_KEY=

# A key bound to a proxy_admin USER (not the master key, and not a key minted
# with user_role on /key/generate - that field is silently ignored). It is a
# control-plane secret: rotate it independently of the gateway.
{{registrationKeyEnv}}=

# The address the card advertises to the LiteLLM proxy, when the container
# cannot infer a reachable one. Must be reachable FROM the proxy's host.
# A2A_CARD_URL=http://<host>:{{listenPort}}
