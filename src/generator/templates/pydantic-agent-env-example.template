# Environment for the {{agentName}} A2A agent.
# Generated by genproj. Do NOT commit real values; inject them from Doppler.
#
# The agent container reads these from its environment at startup.

# The LiteLLM gateway, used for the agent's outbound model calls (and its
# startup self-registration, when that was generated). It must be an address
# the agent's host can resolve - an IP or a working DNS name.
LITELLM_BASE_URL={{litellmBaseUrl}}

# A virtual key scoped to invoking this agent and calling the models it uses.
LITELLM_API_KEY=

{{agentRegisterEnvBlock}}

{{agentStateEnvBlock}}

# The roost fleet hub (see agent/README.md). OPTIONAL, and with NO default: the
# address is not guessable, so with it unset the client is not built at all and
# the agent behaves exactly as before. Set it to make this agent visible in
# roost's fleet view and its History panel.
ROOST_HUB_URL=

# The id this agent presents to roost. Blank derives it from the agent name; if
# the hub enforces tokens this MUST match the id its token map keys on.
ROOST_AGENT_ID=

# OPTIONAL escape hatch: `ROOST_ENABLED=false` keeps the URL but never dials.
ROOST_ENABLED=true

# A NAME, not a value: the variable holding the bearer token (default
# ROOST_AGENT_TOKEN). Only needed if the hub sets ROOST_AGENT_TOKENS.
ROOST_TOKEN_ENV=ROOST_AGENT_TOKEN
ROOST_AGENT_TOKEN=

# The address the card advertises to the LiteLLM proxy - the URL the proxy
# dials. REQUIRED in practice: the in-code default is the wildcard bind address
# (http://0.0.0.0:{{listenPort}}), which the agent REFUSES at startup because
# 0.0.0.0/127.0.0.1/localhost are unreachable from the proxy's host. Set it to
# this agent's reachable address - an IP or a resolvable name on a network the
# proxy shares (e.g. a Tailscale IP, or the container name on a shared Docker
# network), never a loopback address. An empty value is refused too, so this
# MUST be set to a real address.
# A2A_CARD_URL=http://<host>:{{listenPort}}
A2A_CARD_URL=
