#!/bin/bash
# This file is executed every time the dev container starts up or resumes.
# It automatically checks if tailscaled and sshd are running and starts them if not.
#
# NOTE (2026-11-25): the socat tunnel that used to live here has been REMOVED.
# Reason, measured: `socat TCP-LISTEN:9222,bind=127.0.0.1 TCP:host.docker.internal:9222`
# targeted itself. VS Code's SharedProcessTunnelService auto-forwards any port a
# container listens on back to the host, so the chain was
#   container socat -> host 127.0.0.1:9222 (VS Code) -> container 9222 -> socat.
# It never reached a browser, and it occupied host 9222, which is where the shared
# Chrome CDP endpoint needs to bind. Separately, `host.docker.internal` does not
# resolve inside these containers at all: tailscaled runs in-container with
# CorpDNS=true and answers NXDOMAIN for that name.
# The CDP endpoint is now addressed as http://0.250.250.254:9222 (OrbStack's fixed
# host alias). Do NOT reintroduce this tunnel, and do not repoint it to another
# port: any port a container listens on is auto-forwarded, so the loop returns.

echo "INFO: Checking SSH service status..."
if ! pgrep -x sshd >/dev/null; then
    echo "INFO: SSH service not running. Starting it..."
    sudo service ssh restart
fi

echo "INFO: Checking Tailscale status..."
if ! pgrep -x tailscaled >/dev/null; then
    echo "INFO: Tailscale daemon not running. Starting it..."
    sudo start-stop-daemon --start --background --oknodo --pidfile /var/run/tailscaled.pid --make-pidfile --exec /usr/sbin/tailscaled -- --state=/var/lib/tailscale/tailscaled.state
fi

{{docsifyService}}
{{gooseUpdate}}
{{containerAgentService}}

echo "INFO: Services check/startup complete."
