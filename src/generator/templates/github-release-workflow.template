# Generated by genproj. Tag a commit and GitHub publishes a Release for it —
# there is no manual "draft a release" step.
#
# This workflow runs on tags only. Buildkite remains the only validator: a push
# or a pull request never reaches this file.
name: Release

on:
  push:
    tags:
      - "{{githubReleaseTagPattern}}"

# The release is created with this run's own GITHUB_TOKEN, so there is no PAT
# to provision and nothing for a user to paste in.
permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - name: Check out the tagged commit
        uses: actions/checkout@v4
        with:
          # The notes are generated from the commits between the previous tag
          # and this one, so the full history has to be present.
          fetch-depth: 0

      - name: Create the GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
{{githubReleaseCreateScript}}
