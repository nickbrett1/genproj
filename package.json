{
  "name": "genproj",
  "version": "1.0.0",
  "description": "genproj: the project generator and capability catalog, extracted from fintechnick (ftn)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "wrangler dev",
    "build:templates": "node scripts/build-templates.mjs",
    "pretest": "npm run build:templates",
    "test": "vitest --coverage",
    "test:once": "npx vitest run --changed",
    "prebuild": "npm run build:templates",
    "build": "echo 'No build step required'",
    "deploy": "wrangler deploy",
    "lint": "prettier --check . && eslint ."
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,svelte,json,css,html,md}": "prettier --write --ignore-unknown",
    "**/*.{js,ts,svelte}": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "npm@11.19.1",
  "engines": {
    "npm": ">=11 <12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "libsodium-wrappers": "^0.8.4"
  }
}
